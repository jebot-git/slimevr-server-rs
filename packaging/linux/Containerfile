FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl pkg-config libudev-dev libopenxr-dev \
    python3 python3-venv python3-dev patchelf squashfs-tools file \
    desktop-file-utils libgl1 libegl1 libxkbcommon-x11-0 libxcb-cursor0 \
    libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xinerama0 libdbus-1-3 \
    libfontconfig1 libfreetype6 libxrender1 libxi6 libxrandr2 libxfixes3 \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init \
    -o /tmp/rustup-init && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain 1.88.0 \
    && rm /tmp/rustup-init
ENV PATH=/opt/venv/bin:/root/.cargo/bin:$PATH
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir PySide6-Essentials==6.8.3 pyinstaller==6.16.0
RUN curl --fail --location https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage -o /tmp/appimagetool \
    && echo 'ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0  /tmp/appimagetool' | sha256sum -c - \
    && chmod +x /tmp/appimagetool && cd /opt && /tmp/appimagetool --appimage-extract \
    && mv squashfs-root appimagetool && rm /tmp/appimagetool \
    && curl --fail --location https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64 -o /opt/runtime-x86_64 \
    && echo '2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d  /opt/runtime-x86_64' | sha256sum -c -
WORKDIR /source
