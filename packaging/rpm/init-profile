#!/usr/bin/python3
"""Seed a per-user profile on first service start, preserving existing tuning."""
import os
from pathlib import Path

directory = Path.home() / ".config/shora-rust"
directory.mkdir(parents=True, exist_ok=True, mode=0o700)
try:
    fd = os.open(directory / "server.toml", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    pass
else:
    with os.fdopen(fd, "wb") as destination:
        destination.write(Path("/usr/share/slimevr-server-rs/service-default.toml").read_bytes())
