[Unit]
Description=Shora Rust tracking server

[Service]
Type=simple
Environment=XR_RUNTIME_JSON=/usr/share/openxr/1/openxr_wivrn.json
Environment=XDG_RUNTIME_DIR=%t
WorkingDirectory=-%h/.config/shora-rust
ExecStartPre=/usr/libexec/slimevr-server-rs/init-profile
ExecStart=/usr/bin/slimevr-server-rs --config %h/.config/shora-rust/server.toml --solarxr-socket %t/SlimeVRRpc.backend --feeder-socket %t/SlimeVRInput.backend --control-socket %t/SlimeVRControl
ExecStartPost=/usr/bin/python3 /usr/libexec/slimevr-server-rs/wait-sockets.py %t/SlimeVRRpc.backend %t/SlimeVRInput.backend %t/SlimeVRControl
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
UMask=0077
