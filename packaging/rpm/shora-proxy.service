[Unit]
Description=Persistent WiVRn tracking socket proxy
BindsTo=wivrn.service
PartOf=wivrn.service
Before=wivrn.service

[Service]
Type=simple
ExecStart=/usr/bin/shora-proxy --runtime-dir %t
ExecStartPost=/usr/bin/python3 /usr/libexec/slimevr-server-rs/wait-sockets.py %t/SlimeVRRpc %t/SlimeVRInput
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
UMask=0077
